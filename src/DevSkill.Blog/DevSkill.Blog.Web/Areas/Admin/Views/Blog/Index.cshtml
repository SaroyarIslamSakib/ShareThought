@model BlogPostListModel
@{
    ViewData["Title"] = "Index";
}

@section Styles
{
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />
}

<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0">All Products</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">All Products</li>
                </ol>
            </div>
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content Header-->
<!--begin::App Content-->
<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <!--begin::Col-->
            <div class="col-md-12">

                <!--begin::Product List-->
                <div class="card card-primary card-outline mb-4">
                    <!--begin: Advance Search row-->
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title"><i class="fa fa-search mr-1"></i> Search</h3>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label>Title</label>
                                                <input asp-for="SearchItem.Title" type="text" class="form-control" />
                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label>Publish From</label>
                                                <input asp-for="SearchItem.PublishFrom" class="form-control" type="date"  />
                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="form-group">
                                                <label>Publish To</label>
                                                <input asp-for="SearchItem.PublishTo" class="form-control" type="date"   />
                                            </div>
                                        </div>
                                       
                                    </div>
                                </div>
                                <div class="card-footer">
                                    <button id="searchButton" type="submit" class="btn btn-primary float-right">Search</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--end: Advance Search row-->
                    <!--begin::Header-->
                    <div class="card-header"><div class="card-title">Products</div></div>
                    <!--end::Header-->
                    <!--begin::Datatables-->
                    <div class="card-body">
                        <partial name="_ResponsePartial" />
                        <table id="blogs" class="table-bordered">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Body</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot>
                                <tr>
                                    <th>Title</th>
                                    <th>Body</th>

                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <!--end::Datatables-->
                </div>
                <!--end::Product List-->
            </div>
            <!--end::Col-->
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content-->
@section Scripts
{
    <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>

    <script>
        $(function(){
            $("#blogs").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                lengthChange: true,
                autoWidth: false,
                searching: false,
                ajax: {
                    url: "/Admin/Blog/GetBlogPostJsonData",
                    type: "POST",
                    contentType: "application/json",
                    dataType: "json",
                    data: function(d){
                        d.SearchItem = {
                                Title : $("#SearchItem_Title").val(),
                                PublishFrom : $("#SearchItem_PublishFrom").val() === "" ? null : $("#SearchItem_PublishFrom").val(),
                                PublishTo : $("#SearchItem_PublishTo").val() === "" ? null : $("#SearchItem_PublishTo").val()

                        };
                        return JSON.stringify(d);
                    },
                }
            });

            $("#searchButton").click(function(){
            $("#blogs").DataTable().ajax.reload(null, false);
            });

        });
    </script>
}

