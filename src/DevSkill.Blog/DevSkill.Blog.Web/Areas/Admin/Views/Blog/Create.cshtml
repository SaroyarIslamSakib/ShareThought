@model CreateBlogModel
@{
    ViewData["Title"] = "Create";
}

@section Styles {
    <!--begin: Alert : Successfully css-->
    <link rel="stylesheet" href="~/css/alert.css" />
    <!--end: Alert : Successfully css-->
}
<div class="container-fluid col-4">
            <partial name="_ResponsePartial" />
</div>
<div class="container-xxl flex-grow-1 container-p-y">

    <h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Blogs/</span> Create</h4>
    <!-- Basic Layout -->
    <div class="row">

        <div class="col-xl">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Create a new blog</h5>
                    <small class="text-muted float-end">Default label</small>
                </div>
                <div class="card-body">

                    <form asp-area="Admin" asp-controller="Blog" asp-action="Create" asp-antiforgery="true">
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Title</label>
                            <div class="input-group input-group-merge">
                                <span id="basic-icon-default-fullname2" class="input-group-text">
                                    <i class="bx bx-user"></i>
                                </span>
                                <input type="text"
                                       asp-for="Title"
                                       id="basic-icon-default-fullname"
                                       class="form-control"
                                       placeholder="Write Title"
                                       aria-label="John Doe"
                                       aria-describedby="basic-icon-default-fullname2" />
                            </div>
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>



                        <div class="mb-3">
                            <label class="form-label" asp-for="Body">Content</label>
                            <div class="input-group input-group-merge">

                                <textarea id="basic-icon-default-message"
                                          asp-for="Body"
                                          class="form-control"
                                          rows="12"
                                          placeholder="Write your blog here.."
                                          aria-label="Hi, Do you have a moment to talk Joe?"
                                          aria-describedby="basic-icon-default-message2"></textarea>
                            </div>
                            <span asp-validation-for="Body" class="text-danger"></span>
                        </div>
                        <button type="submit" class="btn btn-primary">Create</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/alert.js"></script>
}


