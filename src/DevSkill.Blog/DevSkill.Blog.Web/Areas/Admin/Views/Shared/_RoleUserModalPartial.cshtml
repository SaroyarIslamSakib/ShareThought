@model RoleIndexViewModel

<div class="modal fade" id="roleUserModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Users in Role : <strong>@Model.RoleUser.RoleName</strong>
                </h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                @if (Model.RoleUser.Users.Any())
                {
                    <table class="table table-bordered table-sm">
                        <thead>
                            <tr>
                                <th>User Name</th>
                                <th>Email</th>
                                <th>Phone Number</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.RoleUser.Users)
                            {
                                <tr>
                                    <td>@user.Name</td>
                                    <td>@user.Email</td>
                                    <td>@user.PhoneNumber</td>

                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted text-center mb-0">
                        No users found in this role.
                    </p>
                }

            </div>

        </div>
    </div>
</div>
