@model IndexViewModel
@{
    ViewData["Title"] = "Review Post";
}
@section Styles
{
    <link rel="stylesheet" href="~/css/post-review.css" />
}

<!-- ================= App Content Header ================= -->
<div class="app-content-header">
    <div class="container-fluid">

        <!-- Alert / Response -->
        <div class="row mb-3">
            <div id="responseContainer" class="col-lg-4 col-md-6">
                <partial name="_ResponsePartial" />
            </div>
            <partial name="_ChangeStatusModalPartial" />
        </div>
    </div>
</div>

<!-- ================= App Content ================= -->
<div class="app-content">
    <div class="container-fluid">

        <div class="row g-4">
            <div class="col-lg-8">
                <article class="bg-white rounded-4 shadow-sm px-4 px-md-5 py-5 mx-auto post-article">
                    <input type="hidden" id="postId" value="@Model.PublicPostModel.Id" />
                    <!-- Title -->
                    <h1 class="fw-bold mb-3 text-dark">
                        @Model.PublicPostModel.Title
                    </h1>

                    <!-- Meta -->
                    <div class="post-meta mb-4">
                        <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                            @foreach (var category in Model.PublicPostModel.CategoryNames)
                            {
                                <span class="badge badge-category">
                                    @category
                                </span>
                            }
                            @foreach (var tag in Model.PublicPostModel.TagNames)
                            {
                                <span class="badge badge-tag">
                                    #@tag
                                </span>
                            }
                        </div>
                    </div>
                    <div class="post-actions">

                        <!-- Left -->
                        <div class="actions-left">
                            <button class="action-btn clap-btn"
                                    id="clapBtn"
                                    data-post-id="@Model.PublicPostModel.Id">
                                <i class="fa-regular fa-heart"></i>
                                <span id="clapCount">@Model.PublicPostModel.Likes</span>
                            </button>

                            <div class="action-btn"
                                 role="button"
                                 data-bs-toggle="offcanvas"
                                 data-bs-target="#commentPanel"
                                 aria-controls="commentPanel">

                                <i class="fa-regular fa-comment"></i>
                                <span>@Model.PublicPostModel.Comments</span>
                            </div>
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="post-content">
                        @Html.Raw(Model.PublicPostModel.Content)
                    </div>

                </article>

            </div>
            <div class="col-lg-4">

                <div class="reports-wrapper bg-white rounded-4 shadow-sm p-4">

                    <div class="d-flex justify-content-between align-items-center mb-4">

                        <h5 class="fw-bold mb-0">
                            <i class="fa-solid fa-flag text-danger me-2"></i>
                            Reports (@Model.PublicPostModel.Reports.Count())
                        </h5>

                        <button id="togglePostStatusBtn"
                                class="btn btn-sm @(Model.PublicPostModel.IsSuspended ? "btn-success" : "btn-danger")"
                                data-id="@Model.PublicPostModel.Id"
                                data-status="@Model.PublicPostModel.IsSuspended">
                            @(Model.PublicPostModel.IsSuspended ? "Unban post" : "Ban post")
                        </button>

                    </div>
                    @if (Model.PublicPostModel.Reports != null && Model.PublicPostModel.Reports.Any())
                    {
                        foreach (var report in Model.PublicPostModel.Reports)
                        {
                            <div class="report-card mb-3 p-3 rounded-3 border">

                                <!-- Reason -->
                                <div class="fw-semibold text-danger mb-1">
                                    @report.Reason
                                </div>

                                <!-- Custom Reason -->
                                @if (!string.IsNullOrWhiteSpace(report.CustomReason))
                                {
                                    <div class="small text-muted mb-2">
                                        "@report.CustomReason"
                                    </div>
                                }

                                <!-- Meta -->
                                <div class="d-flex justify-content-between small text-secondary">
                                    <span>@report.CreatedAt.ToString("dd MMM yyyy")</span>
                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">
                            <i class="fa-regular fa-circle-check fs-3 mb-2 text-success"></i>
                            <div>No reports found</div>
                        </div>
                    }

                </div>

            </div>




        </div>

    </div>
</div>
<!--end::App Content-->
@section Scripts {
    <script>
        let selectedPostId = 0;
        let shouldSuspend = false;

        $(document).on("click", "#togglePostStatusBtn", function () {

            selectedPostId = $(this).data("id");
            const status = $(this).data("status");

            if (status === true || status === "True" || status === "true") {

                shouldSuspend = false;

                $("#toggleMessage").text("Are you sure you want to unban this post?");
                $("#confirmToggleBtn")
                    .removeClass("btn-danger")
                    .addClass("btn-success")
                    .text("Yes, Unban");

            } else {

                shouldSuspend = true;

                $("#toggleMessage").text("Are you sure you want to ban this post?");
                $("#confirmToggleBtn")
                    .removeClass("btn-success")
                    .addClass("btn-danger")
                    .text("Yes, Ban");
            }

            const modal = new bootstrap.Modal(document.getElementById('toggleStatusModal'));
            modal.show();
        });


        $("#confirmToggleBtn").off("click").on("click", function () {

            $.ajax({
                url: "/Admin/Post/ToggleSuspend",
                type: "POST",
                data: {
                    id: selectedPostId,
                    suspend: shouldSuspend
                },
                success: function () {

                    const modalEl = document.getElementById('toggleStatusModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalEl);
                    if (modalInstance) modalInstance.hide();

                    toastr.success("Post status updated successfully.");

                    // 🔥 force reload
                    setTimeout(function () {
                        window.location.href = window.location.href;
                    }, 500);
                },
                error: function () {
                    toastr.error("Something went wrong.");
                }
            });

        });
    </script>
}