@{
    ViewData["Title"] = "Index";
}

@section Styles {
    <link rel="stylesheet" href="~/css/navbar.css" />
    <link rel="stylesheet" href="~/css/blog-sub-nav.css" />
    <link rel="stylesheet" href="~/css/blog-dashboard.css" />




}

<main>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Menu -->
            <partial name="_BlogAreaSideMenuPartial" />
            <!-- / Menu -->

            <div class="layout-page">
                <!-- Navbar -->
                <partial name="_BlogAreaNavbarPartial" />
                <!-- / Navbar -->
                <!-- ================= App Content Header ================= -->
                <div class="app-content-header">
                    <div class="container-fluid">

                        <!-- Alert / Response -->
                        <div class="row mb-3">
                            <div id="responseContainer" class="col-lg-4 col-md-6">
                                <partial name="_ResponsePartial" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ================= App Content ================= -->
                <div class="app-content">
                    <div class="container-fluid">
                        <div class="row g-4">
                            <!-- Total Views -->
                            <div class="col-xl-3 col-md-6">
                                <div class="dashboard-card views">
                                    <div class="card-content">
                                        <div class="icon">
                                            <i class="fa-solid fa-eye"></i>
                                        </div>
                                        <div class="details">
                                            <h6>Total Views</h6>
                                            <h3>125,430</h3>
                                            <span class="trend up">
                                                <i class="fa-solid fa-arrow-up"></i> 12.5%
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Today Views -->
                            <div class="col-xl-3 col-md-6">
                                <div class="dashboard-card today">
                                    <div class="card-content">
                                        <div class="icon">
                                            <i class="fa-solid fa-chart-line"></i>
                                        </div>
                                        <div class="details">
                                            <h6>Today Views</h6>
                                            <h3>4,210</h3>
                                            <span class="trend up">
                                                <i class="fa-solid fa-arrow-up"></i> 3.2%
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Unique Visitors -->
                            <div class="col-xl-3 col-md-6">
                                <div class="dashboard-card users">
                                    <div class="card-content">
                                        <div class="icon">
                                            <i class="fa-solid fa-users"></i>
                                        </div>
                                        <div class="details">
                                            <h6>Visitors</h6>
                                            <h3>28,900</h3>
                                            <span class="trend down">
                                                <i class="fa-solid fa-arrow-down"></i> 1.4%
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Bounce Rate -->
                            <div class="col-xl-3 col-md-6">
                                <div class="dashboard-card bounce">
                                    <div class="card-content">
                                        <div class="icon">
                                            <i class="fa-solid fa-arrow-rotate-right"></i>
                                        </div>
                                        <div class="details">
                                            <h6>Bounce Rate</h6>
                                            <h3>32%</h3>
                                            <span class="trend up">
                                                <i class="fa-solid fa-arrow-up"></i> 0.8%
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
                <!--end::App Content-->  
            </div>
            <!-- / Layout page -->
        </div>

        <!-- Overlay -->
        <div class="layout-overlay layout-menu-toggle"></div>
    </div>
    <!-- / Layout wrapper -->
</main>
@section Scripts {
    <script src="~/sneat-1.0.0/assets/js/ui-toasts.js"></script>
    <script src="~/sneat-1.0.0/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/sneat-1.0.0/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/sneat-1.0.0/assets/vendor/libs/masonry/masonry.js"></script>

}