
@model CreatePostViewModel
@{
    ViewData["Title"] = "Write a Blog";
}

@section Styles {
    <link rel="stylesheet" href="~/css/navbar.css" />
    <link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/post-editor.css" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

}

<partial name="_CreatePostModalPartial" model="Model" />
<header class="write-header">
    <div class="write-header-inner">

        <h1 class="blog-title">My Blog</h1>

        <div class="header-right">
            <div class="header-dropdown">
                <button class="dropdown-btn" type="button">⋮</button>

                <div class="dropdown-menu">
                    <button type="button">Add Category</button>
                    <button type="button">Add Tag</button>
                </div>
            </div>

            <button type="button" id="openPublishModal" form="writeForm" class="header-publish">
                Publish
            </button>
        </div>

    </div>
</header>
<div class="mt-0 bg-white">


    <div class="write-page">
        <form asp-area="Blogger" asp-controller="Post" asp-action="Create" asp-antiforgery="true" enctype="multipart/form-data" method="post" class="write-form" id="writeForm">

            <!-- Title -->
            <textarea name="Title"
                      asp-for="Title"
                      class="post-title"
                      rows="1"
                      placeholder="Title"
                      required></textarea>

            <!-- Editor Area -->
            <div class="editor-wrapper">

                <div id="editor"></div>

                <!-- Floating Text Toolbar (FIXED) -->
                <div class="floating-toolbar" id="floatingToolbar">
                    <button type="button" data-format="bold"><span>B</span></button>
                    <button type="button" data-format="italic"><span>I</span></button>
                    <button type="button" data-format="underline"><span>U</span></button>
                    <button type="button" data-format="link">🔗</button>
                </div>

                <!-- Floating Plus -->
                <div class="floating-plus" id="floatingPlus">
                    <button class="plus-btn" type="button" aria-label="Add content">
                        <svg viewBox="0 0 24 24">
                            <path d="M12 5v14M5 12h14" />
                        </svg>
                    </button>

                    <div class="plus-menu">
                        <button type="button" id="addImage">
                            <svg viewBox="0 0 24 24">
                                <rect x="3" y="5" width="18" height="14" rx="2" />
                                <circle cx="9" cy="10" r="1.5" />
                                <path d="M21 15l-5-5-4 4-2-2-5 5" />
                            </svg>
                            <span>Image</span>
                        </button>

                        <button type="button" id="addDivider">
                            <svg viewBox="0 0 24 24">
                                <line x1="4" y1="12" x2="20" y2="12" />
                            </svg>
                            <span>Divider</span>
                        </button>
                    </div>
                </div>

                <!-- Local image picker -->
                <input type="file" id="imageInput" accept="image/*" hidden />
            </div>

            <input asp-for="Content" type="hidden" name="Content" id="content">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ExistingFeatureImagePath" />

        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.quilljs.com/1.3.6/quill.js"></script>
    <script src="~/js/post-editor.js"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
            $(document).ready(function () {

                $('#tagSelect').select2({
                    placeholder: "Type tags...",
                    multiple: true,
                    width: '100%',
                    dropdownParent: $('#publishModal'),
                    minimumInputLength: 1,

                    ajax: {
                        url: '/Blogger/Post/Search',
                        dataType: 'json',
                        delay: 300,
                        data: function (params) {
                            return { term: params.term };
                        },
                        processResults: function (data) {
                            return { results: data };
                        }
                    },

                    tags: true,

                    createTag: function (params) {
                        const term = $.trim(params.term);
                        if (term === '') return null;

                        return {
                            id: term,
                            text: term,
                            newTag: true
                        };
                    },

                    insertTag: function (data, tag) {
                        const exists = data.some(d =>
                            d.text.toLowerCase() === tag.text.toLowerCase()
                        );

                        if (!exists) {
                            data.push(tag);
                        }
                    }
                });


                $('#categorySelect').select2({
                placeholder: "Type categories...",
                multiple: true,
                width: '100%',
                dropdownParent: $('#publishModal'),
                minimumInputLength: 1,

                ajax: {
                    url: '/Blogger/Post/SearchCategory',
                    dataType: 'json',
                    delay: 300,
                    data: function (params) {
                        return { term: params.term };
                    },
                    processResults: function (data) {
                        return { results: data };
                    }
                },

                tags: true,

                createTag: function (params) {
                    const term = $.trim(params.term);
                    if (term === '') return null;

                    return {
                        id: term,
                        text: term,
                        newTag: true
                    };
                },

                insertTag: function (data, tag) {
                    const exists = data.some(d =>
                        d.text.toLowerCase() === tag.text.toLowerCase()
                    );

                    if (!exists) {
                        data.push(tag);
                    }
                }
            });

                /*****************************************
                 * EDIT MODE → PRELOAD EXISTING TAGS
                 *****************************************/
                const existingTags = @Html.Raw(
                                                            System.Text.Json.JsonSerializer.Serialize(Model.TagNames ?? new List<string>())
                                            );

        if (existingTags.length > 0) {
            existingTags.forEach(tag => {
                const option = new Option(tag, tag, true, true);
                $('#tagSelect').append(option);
            });

                    $('#tagSelect').trigger('change');
                }

                // Publish button submit
                $('#finalPublishBtn').on('click', function () {
                    $('#writeForm').submit();
                });
            });



                    const existingCategories = @Html.Raw(
                                System.Text.Json.JsonSerializer.Serialize(Model.CategoryNames ?? new List<string>())
                );

    existingCategories.forEach(cat => {
        const option = new Option(cat, cat, true, true);
        $('#categorySelect').append(option);
    });
    $('#categorySelect').trigger('change');
</script>
}

