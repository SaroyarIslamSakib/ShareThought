@{
    ViewData["Title"] = "Published";
}

@Html.AntiForgeryToken()
@section Styles
{
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />
    <link rel="stylesheet" href="~/css/navbar.css" />
    <link rel="stylesheet" href="~/css/blog-sub-nav.css" />
    <link rel="stylesheet" href="~/css/bloger-post-listview.css" />

}

<main>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Menu -->
            <partial name="_BlogAreaSideMenuPartial" />
            <partial name="_ResponsePartial" />
            <partial name="_DeleteModalPartial" />


            <!-- / Menu -->

            <div class="layout-page">
                <!-- Navbar -->
                <nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme"
                     id="layout-navbar">
                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-4" href="javascript:void(0)">
                            <i class="bx bx-menu bx-sm"></i>
                        </a>
                    </div>

                    <div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">
                        <!-- Brand / Title -->
                        <div class="navbar-nav align-items-center">
                            <a href="#" class="d-flex align-items-center text-decoration-none gap-2">
                                <i class="fa-solid fa-pen-nib fs-4 text-primary"></i>
                                <h4 class="mb-0 fw-bold text-dark lh-1">Blog</h4>
                            </a>
                        </div>

                        <ul class="navbar-nav ms-auto align-items-center">

                            <!-- Write Button -->
                            <li class="nav-item">
                                <a asp-area="Blogger" asp-controller="Post" asp-action="Create"
                                   class="d-flex align-items-center gap-2 px-3 py-2 write-btn text-decoration-none">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="22"
                                         height="22"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.4"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <!-- Square with carved corner -->
                                        <path d="M4 5h7" />
                                        <path d="M4 5v15h15v-7" />

                                        <!-- Pencil body -->
                                        <path d="M9 16.5l1-4.5 9-9 3 3-9 9-4.5 1.5z" />

                                        <!-- Inner pencil line (FIXED: fully inside) -->
                                        <path d="M16.6 5.4l1.9 1.9" />
                                    </svg>

                                    <span class="fw-semibold">Write</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </nav>
                <!-- / Navbar -->

                <div class="content-wrapper">
                    <!-- Content -->
                    <div class="container mt-3">

                        <div class="app-content-header">
                            <div class="container-fluid">

                                <!-- Alert / Response -->
                                <div class="row mb-3">
                                    <div id="responseContainer" class="col-lg-4 col-md-6">
                                    </div>

                                    <div id="messageViewModalContainer"></div>
                                </div>

                                <!-- Title & Breadcrumb -->
                                <nav aria-label="breadcrumb">
                                    <ol class="breadcrumb breadcrumb-style1">
                                        <li class="breadcrumb-item">
                                            <a href="javascript:void(0);">Home</a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="javascript:void(0);">Users</a>
                                        </li>
                                        <li class="breadcrumb-item active">All Users</li>
                                    </ol>
                                </nav>
                            </div>
                        </div>

                        <!-- ================= App Content ================= -->
                        <div class="app-content">
                            <div class="container-fluid">
                                <!-- ================= DataTable Section ================= -->
                                <div class="card card-primary card-outline shadow-sm">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0 fw-semibold">
                                            <i class="fa fa-users me-1 text-primary"></i> Published Post
                                        </h5>
                                    </div>
                                    <div class="mx-3">


                                        <div class="card-body">
                                            <div class="table-responsive">
                                                <table id="posts" class="table table-hover">
                                                    <thead>
                                                        <tr>
                                                            <th>Posts</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody></tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <!--end::App Content-->
                    </div>

                    <!-- / Content -->
                    <div class="content-backdrop fade"></div>
                </div>
                <!-- Content wrapper -->
            </div>
            <!-- / Layout page -->
        </div>

        <!-- Overlay -->
        <div class="layout-overlay layout-menu-toggle"></div>
    </div>
    <!-- / Layout wrapper -->
</main>

@section Scripts
{
    <script src="~/sneat-1.0.0/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/sneat-1.0.0/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/sneat-1.0.0/assets/vendor/libs/masonry/masonry.js"></script>

    <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>
    <script src="~/sneat-1.0.0/assets/js/ui-toasts.js"></script>


    <script>
               $(function () {

            // ================= DataTable =================
        const postsTable = $("#posts").DataTable({
        processing: true,
        serverSide: true,
        paging: true,
        pagingType: "simple",
        lengthChange: false,
        info: false,
        ordering: false,

        searching: true,
            ajax: {
                url: "/Blogger/Post/GetPublishedPostsJsonData",
                type: "POST",
                contentType: "application/json",
                data: d => JSON.stringify(d)
            },
            columns: [
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row) {

            return `
        <div class="post-row">

            <img src="${row[0]}" alt="${row[1]}" />

            <div class="flex-grow-1">
                <h6>${row[1]}</h6>

                <div class="post-meta">
                    Published ${row[3]}
                </div>

                <div class="post-stats">
                    <span>
                        <i class="fa-solid fa-heart"></i> ${row[4]}
                    </span>

                    <span class="ms-3">
                        <i class="fa-solid fa-comment"></i> ${row[6]}
                    </span>
                </div>
            </div>

            <div class="post-actions dropdown">
                <button data-bs-toggle="dropdown">
                    <i class="fa fa-ellipsis"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="/Blogger/Post/Edit/${row[5]}">Edit</a></li>
                    <li>
                    <button class="dropdown-item text-danger btn-delete-post"
                            data-id="${row[5]}">
                            Delete
                    </button>
                </li>
                </ul>
            </div>

        </div>`;
        }
                }
            ]
        });
        });
    </script>
    <script>
        let deletePostId = null;
        const deleteModal = new bootstrap.Modal(
            document.getElementById('deletePostModal')
        );

        // open modal
            $(document).on('click', '.btn-delete-post', function () {
            $('#deletePostIdInput').val($(this).data('id'));
            deleteModal.show();
        });

        // confirm delete
        $('#confirmDeletePostBtn').on('click', function () {

            if (!deletePostId) return;

            $.ajax({
                url: '/Blogger/Post/Delete',
                type: 'POST',
                data: {
                    id: deletePostId,
                    __RequestVerificationToken:
                        $('input[name="__RequestVerificationToken"]').val()
                },
                success: function () {
                    deleteModal.hide();
                    deletePostId = null;

                    // reload DataTable
                    $('#posts').DataTable().ajax.reload(null, false);
                },
                error: function () {
                    alert('Delete failed');
                }
            });
        });
    </script>

}
