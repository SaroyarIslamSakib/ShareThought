@using DevSkill.Blog.Web.Areas.Blogger.Models
@model RegisterModel
@{
    ViewData["Title"] = "Home Page";
}
@section Styles {
    <link rel="stylesheet" href="~/css/landing.css" />
    <link rel="stylesheet" href="~/css/navbar.css" />
    <link rel="stylesheet" href="~/css/why-section.css" />
    <link rel="stylesheet" href="~/css/choice-section.css" />
    <link rel="stylesheet" href="~/css/create-blog-modal.css" />

}
<partial name="_SubNavbarPartial" />
<partial name="_LoginModalPartial" />
<partial name="_RegisterModalPartial" model="Model" />
<partial name="_ResponsePartial" />
<partial name="_CreateBlogModalPartial" model="new CreateBlogAreaModel()" />

<main>
    <div class="landing-body">
        <section class="hero">

            <!-- MAIN CONTENT -->
            <div class="container text-center">
                <h1 class="hero-title">
                    Welcome<br />What do you want to Read
                </h1>
                <p class="hero-subtitle mb-4">
                    You can search for the type of post you like.<br />
                </p>

                <div class="search-center">

                    <div class="search-box search-wrapper mb-4">
                        <input type="text" class="search-input" id="searchInput" placeholder="">
                    </div>
                </div>

                <div class="hero-actions mb-5">
                    <button type="button"
                            class="btn hero-btn-primary"
                            id="openCreateBlog">
                        Create
                    </button>
                    <a asp-area="Blogger" asp-controller="Blog" asp-action="Index" class="btn hero-btn-secondary">My BLog</a>
                </div>
            </div>
            <!-- Dark section -->
            <!--  RULER SVG HERE -->
