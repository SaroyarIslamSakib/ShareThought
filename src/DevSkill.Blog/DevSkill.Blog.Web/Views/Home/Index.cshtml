<script>
    const text = "Discover Your Favorite Posts Across All Blogs and Categories";
    const input = document.getElementById("searchInput");

    let index = 0;

    function typeText() {
        if (index <= text.length) {
            input.setAttribute("placeholder", text.substring(0, index));
            index++;
        } else {
            index = 0;
        }
    }

    setInterval(typeText, 150);
</script>
<script>
    const searchInput = document.getElementById("searchInput");

    searchInput.addEventListener("keydown", function (e) {
        if (e.key === "Enter") {

            const searchText = this.value.trim();

            if (searchText !== "") {
                window.location.href = `/Post/Index?search=${encodeURIComponent(searchText)}`;
            }
        }
    });
</script>
