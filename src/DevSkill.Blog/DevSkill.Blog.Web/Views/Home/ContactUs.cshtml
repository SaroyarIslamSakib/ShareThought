
@{
    ViewData["Title"] = "ContactUs";
}
@section Styles {
    <link rel="stylesheet" href="~/css/navbar.css" />
    <link rel="stylesheet" href="~/css/categoryhead.css" />
    <link rel="stylesheet" href="~/css/contact-us.css"/>


}
<main>
    <section class="tab-content-area">

        <div class="tab-content-item">
            <header class="hero">
                <div class="container">
                    <div class="row align-items-center">

                        <!-- LEFT CONTENT -->
                        <div class="col-12 col-lg-8 text-center">
                            <h1>Have a question, suggestion, or feedback?</h1>

                            <p class="mt-3">
                                Feel free to reach out — I’d love to hear from you.
                            </p>

                            <p class="fw-semibold mt-2">
                                Thank you
                            </p>

                            <a href="#" class="hero-btn">
                                Login to your dashboard →
                            </a>
                        </div>

                        <!-- RIGHT IMAGE -->
                        <div class="col-12 col-lg-4 text-center mt-4 mt-lg-0 container">
                            <img src="~/photos/contact-us.png" alt="Hero Image" class="hero-img">
                        </div>

                    </div>
                </div>
            </header>
            <div class="bg-white">
                <div class="container py-5">
                    <div class="row justify-content-center">
                        <div class="col-xl-6 col-lg-7 col-md-9 col-sm-11">

                            <!-- ================= About You ================= -->
                            <div class="form-section mb-5 shadow-sm">
                                <div class="section-badge">
                                    Please tell us about yourself.
                                </div>

                                <div class="mt-4">
                                    <div class="mb-3">
                                        <label class="form-label">What's your name?</label>
                                        <input type="text" class="form-control">
                                    </div>

                                    <div>
                                        <label class="form-label">What email can we reach you at?</label>
                                        <input type="email" class="form-control">
                                    </div>
                                </div>
                            </div>

                            <!-- ================= What is it about ================= -->
                            <div class="form-section mb-5 shadow-sm">
                                <div class="section-badge">
                                    What is it about?
                                </div>

                                <div class="mt-4">

                                    <div class="form-check radio-box">
                                        <input class="form-check-input" type="radio" name="topic" checked>
                                        <label class="form-check-label">
                                            Create a Blog / Become a Blogger
                                        </label>
                                    </div>

                                    <div class="form-check radio-box">
                                        <input class="form-check-input" type="radio" name="topic">
                                        <label class="form-check-label">
                                            Login / Registration Problem
                                        </label>
                                    </div>

                                    <div class="form-check radio-box">
                                        <input class="form-check-input" type="radio" name="topic">
                                        <label class="form-check-label">
                                            Account Suspension / Access Issue
                                        </label>
                                    </div>

                                    <div class="form-check radio-box">
                                        <input class="form-check-input" type="radio" name="topic">
                                        <label class="form-check-label">
                                            Post Publishing Issue
                                        </label>
                                    </div>

                                    <div class="form-check radio-box">
                                        <input class="form-check-input" type="radio" name="topic">
                                        <label class="form-check-label">
                                            Comment & Moderation Issue
                                        </label>
                                    </div>

                                    <div class="form-check radio-box">
                                        <input class="form-check-input" type="radio" name="topic">
                                        <label class="form-check-label">
                                            Report a Blog or Post
                                        </label>
                                    </div>

                                    <div class="form-check radio-box">
                                        <input class="form-check-input" type="radio" name="topic">
                                        <label class="form-check-label">
                                            Bug Report / Technical Issue
                                        </label>
                                    </div>

                                    <div class="form-check radio-box">
                                        <input class="form-check-input" type="radio" name="topic">
                                        <label class="form-check-label">
                                            Copyright / Legal
                                        </label>
                                    </div>

                                    <div class="form-check radio-box">
                                        <input class="form-check-input" type="radio" name="topic">
                                        <label class="form-check-label">
                                            General Feedback / Opinion
                                        </label>
                                    </div>

                                </div>
                            </div>

                            <!-- ================= Message ================= -->
                            <div class="form-section mb-5 shadow-sm">
                                <div class="section-badge">
                                    What's up?
                                </div>

                                <div class="mt-4">
                                    <label class="form-label">
                                        How can we help you? We are listening
                                    </label>
                                    <textarea class="form-control" rows="5"></textarea>
                                </div>
                            </div>

                            <!-- ================= Button ================= -->
                            <div class="text-center">
                                <button class="btn btn-lg px-5 contact-us-btn">
                                    Send a message!
                                </button>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>
</main>

