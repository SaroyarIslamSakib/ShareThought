@model CreateBlogAreaModel

<div class="modal fade" id="createBlogModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content blog-modal">

            <div class="modal-header blog-header">

                <div class="write-area-modal">
                    <div class="text-wrapper-modal">
                        <h5 class="modal-title mb-0">
                            Create Blog
                        </h5>
                    </div>

                    <svg class="pencil-modal" viewBox="0 0 8 24">
                        <defs>
                            <linearGradient id="bodyGradModal" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="#d1d5db" />
                                <stop offset="100%" stop-color="#ffffff" />
                            </linearGradient>
                        </defs>

                        <rect x="2.5" y="0" width="3" height="2.5" rx="0.7" fill="#e5e7eb" />
                        <rect x="2.5" y="2.5" width="3" height="1.5" fill="#d1d5db" />
                        <rect x="2.5" y="4" width="3" height="8" rx="0.8" fill="url(#bodyGradModal)" />
                        <polygon points="2.5,12 5.5,12 4,16" fill="#f3f4f6" />
                        <polygon points="3,16 5,16 4,19" fill="#111827" />
                    </svg>
                </div>

                <button type="button" class="custom-close-btn" data-bs-dismiss="modal">
                    &times;
                </button>

            </div>


            <form asp-area="" asp-action="Create" asp-controller="Blog" asp-antiforgery="true" method="post">
                <div class="modal-body blog-body">

                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">Blog Name</label>
                        <input asp-for="Name" class="form-control blog-input" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control blog-input" rows="3"></textarea>
                    </div>

                </div>

                <div class="modal-footer blog-footer">
                    <button type="submit" class="btn blog-btn w-100">
                        Create Blog
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>