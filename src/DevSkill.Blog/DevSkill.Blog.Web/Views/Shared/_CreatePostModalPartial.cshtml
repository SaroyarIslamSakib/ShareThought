@model CreatePostViewModel
<div class="modal fade" id="publishModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Publish Post</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="mb-3">
                    <label asp-for="CategoryNames" class="form-label">
                        Categories
                    </label>
                    <input type="text"
                           asp-for="CategoryNames"
                           class="form-control"
                           placeholder="e.g. Tech, Programming, .NET"
                           form="writeForm" />
                    <small class="text-muted">
                        Separate multiple categories with comma
                    </small>
                </div>
                <!-- TAG INPUT -->
                <div class="mb-3">
                    <label asp-for="TagNames" class="form-label">
                        Tags
                    </label>
                    <input type="text"
                           asp-for="TagNames"
                           class="form-control"
                           placeholder="e.g. asp.net, ef core, ddd"
                           form="writeForm" />
                    <small class="text-muted">
                        Separate tags with comma
                    </small>
                </div>
                @if (Model != null && !string.IsNullOrEmpty(Model.ExistingFeatureImagePath))
                {
                    <div class="mb-3 text-center">
                        <p class="mb-1 text-muted small">Current Feature Image</p>
                        <img src="@Model.ExistingFeatureImagePath"
                             class="img-fluid rounded"
                             style="max-height: 180px;" />
                    </div>
                }
                <label asp-for="FeatureImage" class="form-label">Feature Image</label>
                <input type="file"
                       asp-for="FeatureImage"
                       class="form-control"
                       id="featureImageInput"
                       accept="image/*"
                       form="writeForm" />
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        id="finalPublishBtn"
                        class="btn btn-primary">
                    Publish Now
                </button>
            </div>

        </div>
    </div>
</div>
