@model RegisterModel
<div class="modal fade" id="registerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content blog-modal">

            <!-- HEADER (Same Style as Others) -->
            <div class="modal-header blog-header">

                <div class="write-area-modal">
                    <div class="text-wrapper-modal">
                        <h5 class="modal-title mb-0">
                            Register
                        </h5>
                    </div>

                    <svg class="pencil-modal" viewBox="0 0 8 24">
                        <defs>
                            <linearGradient id="bodyGradRegister" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="#d1d5db" />
                                <stop offset="100%" stop-color="#ffffff" />
                            </linearGradient>
                        </defs>

                        <rect x="2.5" y="0" width="3" height="2.5" rx="0.7" fill="#e5e7eb" />
                        <rect x="2.5" y="2.5" width="3" height="1.5" fill="#d1d5db" />
                        <rect x="2.5" y="4" width="3" height="8" rx="0.8" fill="url(#bodyGradRegister)" />
                        <polygon points="2.5,12 5.5,12 4,16" fill="#f3f4f6" />
                        <polygon points="3,16 5,16 4,19" fill="#111827" />
                    </svg>
                </div>

                <button type="button"
                        class="custom-close-btn"
                        data-bs-dismiss="modal">
                    &times;
                </button>

            </div>

            <!-- BODY -->
            <div class="modal-body blog-body px-4">

                <h5 class="mb-2 fw-semibold">Register to be a member</h5>
                <p class="mb-4 text-muted small">
                    Create your account to continue.
                </p>

                <form asp-controller="Account"
                      asp-action="Register"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="FirstName" class="form-label">First Name</label>
                            <input asp-for="FirstName"
                                   class="form-control blog-input"
                                   type="text"
                                   placeholder="Enter your first name" />
                            <span asp-validation-for="FirstName"
                                  class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label">Last Name</label>
                            <input asp-for="LastName"
                                   class="form-control blog-input"
                                   type="text"
                                   placeholder="Enter your last name" />
                            <span asp-validation-for="LastName"
                                  class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label">Phone Number</label>
                        <input asp-for="PhoneNumber"
                               class="form-control blog-input"
                               type="text"
                               placeholder="Enter your phone number" />
                        <span asp-validation-for="PhoneNumber"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email"
                               class="form-control blog-input"
                               type="email"
                               placeholder="Enter your email" />
                        <span asp-validation-for="Email"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input asp-for="Password"
                               type="password"
                               class="form-control blog-input" />
                        <span asp-validation-for="Password"
                              class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Confirm Password</label>
                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control blog-input" />
                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger small"></span>
                    </div>

                    <button class="btn blog-btn w-100">
                        Sign Up
                    </button>
                </form>

                <p class="text-center mt-3 small">
                    <span>Already have an account?</span>
                    <a href="javascript:void(0)"
                       id="openLoginFromRegister"
                       class="fw-semibold text-dark">
                        Sign in instead
                    </a>
                </p>

            </div>

        </div>
    </div>
</div>
