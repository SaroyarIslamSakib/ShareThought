@model IndexViewModel

<div class="modal fade" id="reportModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa-solid fa-flag text-danger me-2"></i>
                    Report Post
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <form id="reportForm" method="post" asp-area="" asp-controller="Report" asp-action="SendReport" asp-antiforgery=true>
                <div class="modal-body">

                    <input asp-for="SendReportModel.PostId" type="hidden" id="reportPostId" />

                    <p class="fw-semibold mb-2">Why are you reporting this post?</p>
                    <!-- Radio Options -->
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" asp-for="SendReportModel.Reason" value="Harassment" id="r1">
                        <label class="form-check-label" for="r1">
                            Harassment
                        </label>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" asp-for="SendReportModel.Reason" value="RulesViolation" id="r2">
                        <label class="form-check-label" for="r2">
                            Rules Violation
                        </label>

                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" asp-for="SendReportModel.Reason" value="Spam" id="r3">
                        <label class="form-check-label" for="r3">
                            Spam
                        </label>

                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="radio" asp-for="SendReportModel.Reason" value="AiGenerated" id="r4">
                        <label class="form-check-label" for="r4">
                            AI-generated content
                        </label>
                    </div>

                    <hr />

                    <!-- Custom Text -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Or write your reason
                        </label>
                        <textarea class="form-control"
                                  asp-for="SendReportModel.CustomReason"
                                  rows="3"
                                  placeholder="Write details (optional)"></textarea>
                        <span asp-validation-for="SendReportModel.CustomReason" class="text-danger"></span>

                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-danger">
                        Submit Report
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>
