@{
    ViewData["Title"] = "Index";
}

@Html.AntiForgeryToken()
@section Styles
{
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.5/css/dataTables.dataTables.css" />
    <link rel="stylesheet" href="~/css/navbar.css" />
    <link rel="stylesheet" href="~/css/blog-sub-nav.css" />
}

<main>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Menu -->
            <partial name="_BlogAreaSideMenuPartial" />
            <!-- / Menu -->

            <div class="layout-page">
                <!-- Navbar -->
                <nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme"
                     id="layout-navbar">
                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-3 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-4" href="javascript:void(0)">
                            <i class="bx bx-menu bx-sm"></i>
                        </a>
                    </div>

                    <div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">
                        <!-- Brand / Title -->
                        <div class="navbar-nav align-items-center">
                            <a href="#" class="d-flex align-items-center text-decoration-none gap-2">
                                <i class="fa-solid fa-pen-nib fs-4 text-primary"></i>
                                <h4 class="mb-0 fw-bold text-dark lh-1">Blog</h4>
                            </a>
                        </div>

                        <ul class="navbar-nav ms-auto align-items-center">

                            <!-- Write Button -->
                            <li class="nav-item">
                                <a asp-area="" asp-controller="Post" asp-action="Create"
                                   class="d-flex align-items-center gap-2 px-3 py-2 write-btn text-decoration-none">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="22"
                                         height="22"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="1.4"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <!-- Square with carved corner -->
                                        <path d="M4 5h7" />
                                        <path d="M4 5v15h15v-7" />

                                        <!-- Pencil body -->
                                        <path d="M9 16.5l1-4.5 9-9 3 3-9 9-4.5 1.5z" />

                                        <!-- Inner pencil line (FIXED: fully inside) -->
                                        <path d="M16.6 5.4l1.9 1.9" />
                                    </svg>

                                    <span class="fw-semibold">Write</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </nav>
                <!-- / Navbar -->

                <div class="content-wrapper">
                    <!-- Content -->
                    <div class="container mt-3">

                        <div class="app-content-header">
                            <div class="container-fluid">

                                <!-- Alert / Response -->
                                <div class="row mb-3">
                                    <div id="responseContainer" class="col-lg-4 col-md-6">
                                        <partial name="_ResponsePartial" />
                                    </div>

                                    <div id="messageViewModalContainer"></div>
                                </div>

                                <!-- Title & Breadcrumb -->
                                <nav aria-label="breadcrumb">
                                    <ol class="breadcrumb breadcrumb-style1">
                                        <li class="breadcrumb-item">
                                            <a href="javascript:void(0);">Home</a>
                                        </li>
                                        <li class="breadcrumb-item">
                                            <a href="javascript:void(0);">Users</a>
                                        </li>
                                        <li class="breadcrumb-item active">All Users</li>
                                    </ol>
                                </nav>
                            </div>
                        </div>

                        <!-- ================= App Content ================= -->
                        <div class="app-content">
                            <div class="container-fluid">
                                <!-- ================= DataTable Section ================= -->
                                <div class="card card-primary card-outline shadow-sm">
                                    <div class="card-header d-flex justify-content-between align-items-center">
                                        <h5 class="mb-0 fw-semibold">
                                            <i class="fa fa-users me-1 text-primary"></i> Posts
                                        </h5>

                                        <button type="button"
                                                class="btn btn-danger btn-sm delete-all-msg-modal">
                                            <i class="fa fa-trash"></i> Delete all
                                        </button>
                                    </div>
                                    <div class="mx-3">


                                        <div class="card-body">
                                            <div class="table-responsive">
                                                <table id="posts" class="table table-hover align-middle table-bordered">
                                                    <thead class="table-light text-muted small">
                                                        <tr>
                                                            <th>Image</th>
                                                            <th>Title</th>
                                                            <th>Content</th>
                                                            <th>CreatedAt</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody></tbody>
                                                    <tfoot class="table-light small">
                                                        <tr>
                                                            <th>Image</th>
                                                            <th>Title</th>
                                                            <th>Content</th>
                                                            <th>CreatedAt</th>
                                                            <th>Action</th>
                                                        </tr>
                                                    </tfoot>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <!--end::App Content-->
                    </div>

                    <!-- / Content -->
                    <div class="content-backdrop fade"></div>
                </div>
                <!-- Content wrapper -->
            </div>
            <!-- / Layout page -->
        </div>

        <!-- Overlay -->
        <div class="layout-overlay layout-menu-toggle"></div>
    </div>
    <!-- / Layout wrapper -->
</main>

@section Scripts
{
    <script src="~/sneat-1.0.0/assets/vendor/libs/popper/popper.js"></script>
    <script src="~/sneat-1.0.0/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/sneat-1.0.0/assets/vendor/libs/masonry/masonry.js"></script>

    <script src="https://cdn.datatables.net/2.3.5/js/dataTables.js"></script>
    <script src="~/sneat-1.0.0/assets/js/ui-toasts.js"></script>


    <script>
               $(function () {

            // ================= DataTable =================
            const messagesTable = $("#posts").DataTable({
                processing: true,
                serverSide: true,
                responsive: true,
                lengthChange: true,
                autoWidth: false,
                ajax: {
                    url: "/Post/GetPostsJsonData",
                    type: "POST",
                    contentType: "application/json",
                    dataType: "json",
                    data: function (d) {
                        d.SearchItem = {};
                        return JSON.stringify(d);
                    }
                },

                                columnDefs: [{
            orderable: false,
            targets: 0,
            render: function (data, type, row) {
                if (!data) {
                    return `<span class="text-muted">No Image</span>`;
                }

                return `
                    <img
                        width="50"
                        src="${data}"
                        alt="${row[1]}"
                        class="img-fluid rounded"
                    />`;
            }
        }]
                    });
        });
    </script>

}